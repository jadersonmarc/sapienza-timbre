# Banco PRÓPRIO do Timbre (não é o do core). public = camada compartilhada do
# Timbre; tenant_<id> = operação por produtor.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/timbre

# Porta do serviço
PORT=8082

# Segredo do JWT NATIVO do Timbre (assina e valida a sessão do colaborador).
# Gere com: openssl rand -base64 48
TIMBRE_JWT_SECRET=troque-por-um-segredo-forte

# Token de bootstrap para criar produtor (POST /api/v1/producers via X-Admin-Token).
# Vazio DESLIGA a criação. A aprovação de produtor vira UI de admin na Etapa 1.7.
TIMBRE_ADMIN_TOKEN=

# Reservado: AES-256-GCM p/ segredos por-tenant (32 bytes base64). Não usado na 1.1.
TIMBRE_ENC_KEY=

# Nível de log (debug|info|warn|error)
LOG_LEVEL=info

# Gateway Asaas (Etapa 1.4). Vazio = stub não-configurado.
ASAAS_API_KEY=
