# Banco PRÓPRIO do Timbre (não é o do core). public = camada compartilhada do
# Timbre; tenant_<id> = operação por produtor.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/timbre

# Porta do serviço
PORT=8082

# Segredo do JWT NATIVO do Timbre (assina e valida a sessão do colaborador).
# Gere com: openssl rand -base64 48
TIMBRE_JWT_SECRET=troque-por-um-segredo-forte

# Token de bootstrap para criar produtor (POST /api/v1/producers via X-Admin-Token).
# Vazio DESLIGA a criação. O cadastro PÚBLICO de produtor é self-service (nasce ativo).
TIMBRE_ADMIN_TOKEN=

# Seed do primeiro super_admin do painel /admin (idempotente). Vazio = não cria. O
# operador da plataforma loga em POST /api/v1/admin/login com estas credenciais.
TIMBRE_ADMIN_EMAIL=
TIMBRE_ADMIN_PASSWORD=

# Reservado: AES-256-GCM p/ segredos por-tenant (32 bytes base64). Não usado na 1.1.
TIMBRE_ENC_KEY=

# Seed Ed25519 (32 bytes base64) para assinar ingressos. A portaria embarca a chave
# PÚBLICA correspondente (logada no boot). Gere: openssl rand -base64 32
# Vazio = chave efêmera (o QR muda a cada restart) — só para dev.
TIMBRE_TICKET_SIGNING_KEY=

# Seed Ed25519 (32 bytes base64) da chave de ATESTAÇÃO — assina o resumo do registro
# canônico no fechamento do evento. Distinta da chave do QR. Gere: openssl rand -base64 32
# Vazio = chave efêmera (dev).
TIMBRE_ATTESTATION_KEY=

# Identificador curto e estável da chave de atestação (ex.: "att-2026-01"). A verificação
# pública resolve a chave PELO key_id do atestado — nunca pela chave corrente. Obrigatório
# quando TIMBRE_ATTESTATION_KEY é definida.
TIMBRE_ATTESTATION_KEY_ID=

# Âncora do atestado: off (default) ou log. Não existe cliente HTTP de Relayer: em 'log' a
# intenção é registrada e o atestado permanece anchor_status 'none' — nada vira 'anchored'
# sem transação real.
TIMBRE_ANCHOR_MODE=off

# Fechamento automático do evento N horas após ends_at (default 24).
EVENT_CLOSE_AFTER_HOURS=24

# Nível de log (debug|info|warn|error)
LOG_LEVEL=info

# Gateway Asaas (Etapa 1.4). Vazio = FakeGateway (determinístico, sem rede).
ASAAS_API_KEY=
# Base URL do Asaas: produção (default) ou sandbox (https://api-sandbox.asaas.com).
ASAAS_BASE_URL=
# Token que o Asaas envia no header asaas-access-token do webhook. Vazio = sem checagem.
ASAAS_WEBHOOK_TOKEN=

# Rede (Base / ERC-1155). DORMENTE: a emissão ERC-1155 está desativada por desenho (o
# eixo on-chain é prova por âncora, não posse por token). Mantido apenas como stub.
CHAIN_RPC_URL=
CHAIN_CONTRACT=

# Modo de emissão on-chain: off (default) — nenhum caminho materializa token.
CHAIN_MINT_MODE=off
