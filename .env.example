# Banco PRÓPRIO do Timbre (não é o do core). public = camada compartilhada do
# Timbre; tenant_<id> = operação por produtor.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/timbre

# Porta do serviço
PORT=8082

# Segredo do JWT NATIVO do Timbre (assina e valida a sessão do colaborador).
# Gere com: openssl rand -base64 48
TIMBRE_JWT_SECRET=troque-por-um-segredo-forte

# Token de bootstrap para criar produtor (POST /api/v1/producers via X-Admin-Token).
# Vazio DESLIGA a criação. O cadastro PÚBLICO de produtor é self-service (nasce ativo).
TIMBRE_ADMIN_TOKEN=

# Seed do primeiro super_admin do painel /admin (idempotente). Vazio = não cria. O
# operador da plataforma loga em POST /api/v1/admin/login com estas credenciais.
TIMBRE_ADMIN_EMAIL=
TIMBRE_ADMIN_PASSWORD=

# Reservado: AES-256-GCM p/ segredos por-tenant (32 bytes base64). Não usado na 1.1.
TIMBRE_ENC_KEY=

# Seed Ed25519 (32 bytes base64) para assinar ingressos. A portaria embarca a chave
# PÚBLICA correspondente (logada no boot). Gere: openssl rand -base64 32
# Vazio = chave efêmera (o QR muda a cada restart) — só para dev.
TIMBRE_TICKET_SIGNING_KEY=

# Seed Ed25519 (32 bytes base64) da chave de ATESTAÇÃO — assina o resumo do registro
# canônico no fechamento do evento. Distinta da chave do QR. Gere: openssl rand -base64 32
# Vazio = chave efêmera (dev).
TIMBRE_ATTESTATION_KEY=

# Identificador curto e estável da chave de atestação (ex.: "att-2026-01"). A verificação
# pública resolve a chave PELO key_id do atestado — nunca pela chave corrente. Obrigatório
# quando TIMBRE_ATTESTATION_KEY é definida.
TIMBRE_ATTESTATION_KEY_ID=

# Âncora do atestado: off (default) ou log. Não existe cliente HTTP de Relayer: em 'log' a
# intenção é registrada e o atestado permanece anchor_status 'none' — nada vira 'anchored'
# sem transação real.
TIMBRE_ANCHOR_MODE=off

# Fechamento automático do evento N horas após ends_at (default 24).
EVENT_CLOSE_AFTER_HOURS=24

# Extensão única da reserva no auth-started/bind da sessão de checkout (segundos). A conta é
# exigida no momento de pagar; ao pedir o código (auth-started) ou vincular (bind), a reserva
# é estendida uma vez por este valor (default 600).
TIMBRE_CHECKOUT_AUTH_GRACE=600

# Limites da sessão de checkout (configuráveis; defaults calibrados para CGNAT/operadora).
# Teto de sessões abertas por IP (default 50) e de assentos reservados por IP em evento com
# assento marcado (default 20; evento em pé não aplica).
TIMBRE_CHECKOUT_MAX_OPEN_SESSIONS=50
TIMBRE_CHECKOUT_MAX_HELD_SEATS=20
# TTL da sessão anônima (default 900s/15min) e vinculada (default 3600s/60min).
TIMBRE_CHECKOUT_ANON_TTL=900
TIMBRE_CHECKOUT_AUTH_TTL=3600
# Retenção do client_ip de sessões pagas antes do expurgo (segundos; default 604800 = 7 dias).
TIMBRE_CHECKOUT_IP_RETENTION=604800

# Nível de log (debug|info|warn|error)
LOG_LEVEL=info

# ── Notificação (e-mail) ──────────────────────────────────────────────────────
# Basta definir a chave e o remetente: sem TIMBRE_NOTIFIER, o provedor é DEDUZIDO (com
# chave + remetente → resend; sem eles → log, que registra e NÃO envia). Os nomes do
# console (RESEND_API_KEY/MAIL_FROM) também são aceitos; o prefixo TIMBRE_ tem prioridade.
# TIMBRE_NOTIFIER só é preciso para forçar: log (desliga o envio) | resend.
TIMBRE_NOTIFIER=
# Chave da API do Resend (ou RESEND_API_KEY). Nunca em log.
TIMBRE_RESEND_API_KEY=
# Remetente "Nome <email>" (ou MAIL_FROM). O domínio de envio NÃO é fixo no código —
# trocar para o domínio próprio depois é mudança só desta variável.
TIMBRE_MAIL_FROM=Timbre <nao-responda@exemplo.com>
TIMBRE_MAIL_REPLY_TO=
# Base pública do site, para montar links (ex.: meus ingressos) nas mensagens.
TIMBRE_PUBLIC_BASE_URL=https://timbre.sapienzalabs.com.br

# Gateway Asaas (Etapa 1.4). Vazio = FakeGateway (determinístico, sem rede).
ASAAS_API_KEY=
# Base URL do Asaas: só o HOST, sem "/v3" (o cliente já monta /v3/...). Vazio = produção
# (https://api.asaas.com); sandbox = https://api-sandbox.asaas.com. Uma base com a versão
# junto autentica e devolve 404 na cobrança — o boot registra a base efetiva em uso.
ASAAS_BASE_URL=
# Token que o Asaas envia no header asaas-access-token do webhook. Vazio = sem checagem.
ASAAS_WEBHOOK_TOKEN=
# O webhook precisa estar configurado no painel do Asaas para DOIS fluxos: cobranças/splits
# (conta do Timbre) e situação de subconta (cadastro dos produtores). As tarifas usadas no
# preço vêm de GET /myAccount/fees — nunca há valor de tarifa chumbado no código.

# Rede (Base / ERC-1155). DORMENTE: a emissão ERC-1155 está desativada por desenho (o
# eixo on-chain é prova por âncora, não posse por token). Mantido apenas como stub.
CHAIN_RPC_URL=
CHAIN_CONTRACT=

# Modo de emissão on-chain: off (default) — nenhum caminho materializa token.
CHAIN_MINT_MODE=off
